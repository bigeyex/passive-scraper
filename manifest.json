{
    "manifest_version": 3,
    "name": "Passive Scraper",
    "version": "1.0",
    "description": "Passively scrape data from web requests based on user-defined plans.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup/index.html"
    },
    "background": {
        "service_worker": "scripts/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "scripts/content.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ]
}